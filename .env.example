# Copy to .env for local development

# Login password (required)
PWORD=changeme
# Secret used to sign login tokens (falls back to PWORD if unset)
JWT_SECRET=change-me-to-a-long-random-string

# Optional: Upstash Redis. Without these, data is stored in bp-data.json.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: daily GitHub backups (production only, see README)
# CRON_SECRET=
# GITHUB_TOKEN=
# GITHUB_BACKUP_REPO=username/bp-backups
